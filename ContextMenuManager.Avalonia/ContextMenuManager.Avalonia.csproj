<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 本工具只面向 Windows（注册表 / Win32 互操作），与 WPF 版一致 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>ContextMenuManager</AssemblyName>
    <RootNamespace>ContextMenuManager.Avalonia</RootNamespace>
    <Product>右键菜单管家</Product>
    <Version>1.0.0</Version>

    <!-- 默认 asInvoker；写入 HKLM 时按需请求提权并续跑（与 WPF 版一致） -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Avalonia 12 默认启用编译绑定 -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- AVLN3001：MsgBox / AddItemDialog 只经代码 new 出来，不走运行时 XAML 加载器 -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
  </ItemGroup>

  <!-- dotnet publish -c Release 时生成单文件 exe（与原 WPF 版发布方式一致） -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
    <!-- Avalonia 原生库（SkiaSharp 等）打包进 exe，运行时解压到临时目录 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- 发布后清理原生调试符号，保证输出目录只剩单文件 -->
  <Target Name="CleanNativeSymbols" AfterTargets="Publish">
    <ItemGroup>
      <_PublishSymbols Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PublishSymbols)" />
    <Message Importance="high" Text="已清理发布符号：@(_PublishSymbols)" Condition="'@(_PublishSymbols)' != ''" />
  </Target>

</Project>
