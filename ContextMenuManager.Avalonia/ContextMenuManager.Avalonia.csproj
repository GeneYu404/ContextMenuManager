<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 本工具只面向 Windows（注册表 / Win32 互操作），与 WPF 版一致 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>ContextMenuManager.Avalonia</AssemblyName>
    <RootNamespace>ContextMenuManager.Avalonia</RootNamespace>
    <Product>右键菜单管家</Product>
    <Version>1.0.0</Version>

    <!-- 默认 asInvoker；写入 HKLM 时按需请求提权并续跑（与 WPF 版一致） -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Avalonia 12 默认启用编译绑定 -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- AVLN3001：MsgBox / AddItemDialog 只经代码 new 出来，不走运行时 XAML 加载器 -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
  </ItemGroup>

  <!-- 与 WPF 版共享的纯 .NET 源码：链接编译，保持单一事实来源。
       分叉文件（IconLoader / MainViewModel / ItemViewModels / Infrastructure / Views / Converters）
       由本工程目录下的同名或适配版本参与编译，见 AGENTS.md。 -->
  <ItemGroup>
    <Compile Include="..\ContextMenuManager\Models\*.cs" LinkBase="Shared\Models" />
    <Compile Include="..\ContextMenuManager\Services\*.cs" Exclude="..\ContextMenuManager\Services\IconLoader.cs" LinkBase="Shared\Services" />
    <Compile Include="..\ContextMenuManager\ViewModels\LogStore.cs" LinkBase="Shared\ViewModels" />
  </ItemGroup>

  <!-- dotnet publish -c Release 时生成单文件 exe（与 WPF 版发布方式一致） -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
